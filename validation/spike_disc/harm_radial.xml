<?xml version="1.0"?>
<cfsSimulation xmlns="http://www.cfs++.org/simulation">
  <!-- Spike: PZT-4 disc, a = 10.5 mm, t = 1.5 mm, full-face electrodes, axisymmetric. Harmonic, 1 V on top, fine sweep around the fundamental radial mode. -->
  <fileFormats>
    <input>
      <gmsh fileName="disc.msh"/>
    </input>
    <output>
      <hdf5/>
      <text id="txt"/>
    </output>
    <materialData file="mat.xml" format="xml"/>
  </fileFormats>

  <domain geometryType="axi">
    <regionList>
      <region name="piezo" material="PZT-4"/>
    </regionList>
    <surfRegionList>
      <surfRegion name="top"/>
      <surfRegion name="bottom"/>
      <surfRegion name="axis"/>
      <surfRegion name="outer"/>
    </surfRegionList>
  </domain>

  <sequenceStep>
    <analysis>
      <harmonic>
        <numFreq>351</numFreq>
        <startFreq>95e3</startFreq>
        <stopFreq>130e3</stopFreq>
        <sampling>linear</sampling>
      </harmonic>
    </analysis>

    <pdeList>
      <mechanic subType="axi">
        <regionList>
          <region name="piezo" complexMaterial="yes"/>
        </regionList>
        <bcsAndLoads>
          <fix name="axis">
            <comp dof="r"/>
          </fix>
        </bcsAndLoads>
        <storeResults>
          <nodeResult type="mechDisplacement">
            <allRegions/>
          </nodeResult>
        </storeResults>
      </mechanic>

      <electrostatic>
        <regionList>
          <region name="piezo" complexMaterial="yes"/>
        </regionList>
        <bcsAndLoads>
          <ground name="bottom"/>
          <potential name="top" value="1"/>
        </bcsAndLoads>
        <storeResults>
          <nodeResult type="elecPotential">
            <allRegions/>
          </nodeResult>
        </storeResults>
      </electrostatic>
    </pdeList>

    <couplingList>
      <direct>
        <piezoDirect>
          <regionList>
            <region name="piezo" complexMaterial="yes"/>
          </regionList>
          <storeResults>
            <surfRegionResult type="elecCharge">
              <surfRegionList>
                <surfRegion name="top" neighborRegion="piezo"/>
                <surfRegion name="bottom" neighborRegion="piezo"/>
              </surfRegionList>
            </surfRegionResult>
          </storeResults>
        </piezoDirect>
      </direct>
    </couplingList>

    <linearSystems>
      <system>
        <solverList>
          <directLU/>
        </solverList>
      </system>
    </linearSystems>
  </sequenceStep>
</cfsSimulation>
